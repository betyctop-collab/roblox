      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Constants</string>
          <string name="Source"><![CDATA[--!strict
--
-- Tunables for the RNG katana game. Keep design knobs here so gameplay code
-- stays declarative.

local Constants = {}

-- Auto-roll
Constants.AutoRollIntervalSeconds = 5
Constants.ClickRollCooldownSeconds = 0.25 -- minimum gap between manual rolls
Constants.MaxLuckMultiplier = 50

-- DataStore
Constants.DataStoreName = "RngKatanaProfileV1"
Constants.SaveOnLeavingDelay = 0.1

-- Server-wide announcement (in-chat + HUD ribbon)
Constants.ServerAnnounceDurationSeconds = 8

-- Boost shop
Constants.BoostShop = {
	{ Id = 1, Name = "Lucky Charm", Multiplier = 2, DurationSeconds = 60, Cost = 100 },
	{ Id = 2, Name = "Spirit Surge", Multiplier = 5, DurationSeconds = 30, Cost = 500 },
	{ Id = 3, Name = "Heaven's Gaze", Multiplier = 10, DurationSeconds = 15, Cost = 2500 },
}

-- Maximum number of recent server-wide drops kept in the announcement ribbon.
Constants.MaxRecentAnnouncements = 5

return Constants
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">IconIds</string>
          <string name="Source"><![CDATA[--!strict
--
-- Maps each UI icon to a renderable Roblox content URL.
--
-- We upload PNGs through Open Cloud as `Decal` assets. `ImageLabel.Image`
-- does not always resolve a Decal asset id to its underlying image (the
-- known Open Cloud v1 limitation), so we wrap each asset id in an
-- `rbxthumb://` URL. Roblox renders the asset thumbnail directly for any
-- moderated asset, regardless of Decal vs Image.

local function thumb(id: number | string): string
	return string.format("rbxthumb://type=Asset&id=%s&w=150&h=150", tostring(id))
end

local IconIds = {}

IconIds.Coins = thumb(129821412159941)
IconIds.Star = thumb(78272383498199)
IconIds.Award = thumb(137168226945155)
IconIds.Swords = thumb(117853458456059)
IconIds.Backpack = thumb(130041043029819)
IconIds.Settings = thumb(132313126833268)
IconIds.X = thumb(101630352653283)
IconIds.Zap = thumb(108322398259982)
IconIds.Users = thumb(76803702792254)
IconIds.Dice = thumb(139215674289272)
IconIds.Lock = thumb(76095830145333)
IconIds.Sparkles = thumb(93854979309880)

IconIds.DiamondSword = thumb(131744572864689)

IconIds.Fallback = {
	Coins = "$",
	Star = "★",
	Award = "🏆",
	Swords = "⚔",
	Backpack = "🎒",
	Settings = "⚙",
	X = "✕",
	Zap = "⚡",
	Users = "👥",
	Dice = "🎲",
	Lock = "🔒",
	Sparkles = "✨",
	DiamondSword = "🗡",
}

return IconIds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--!strict
--
-- Anime-katana item catalogue. Each item belongs to exactly one rarity tier
-- and is what RollService awards when that tier wins a roll.

local Rarities = require(script.Parent.Rarities)

export type Item = {
	Id: number,
	Name: string,
	RarityKey: string,
	Lore: string,
}

local function item(id: number, name: string, rarityKey: string, lore: string): Item
	assert(Rarities.ByKey[rarityKey], `unknown rarity {rarityKey}`)
	return {
		Id = id,
		Name = name,
		RarityKey = rarityKey,
		Lore = lore,
	}
end

local Items = {}

-- The full catalogue. Order matters for the Index UI.
Items.All = {
	-- Common (1/2)
	item(1, "Wooden Bokken", "Common", "Stiff oak. Hurts your wrist more than your foes."),
	item(2, "Bamboo Stick", "Common", "Snaps in a single duel. The dojo charges 50 yen each."),
	item(3, "Practice Sword", "Common", "Dull edge. Polished by countless apprentices."),

	-- Uncommon (1/8)
	item(
		4,
		"Steel Katana",
		"Uncommon",
		"A reliable workhorse. The smith's signature is half-rubbed."
	),
	item(5, "Iron Wakizashi", "Uncommon", "Short, fast, and unflattering."),
	item(
		6,
		"Apprentice Blade",
		"Uncommon",
		"Comes with a 'Beginner-Friendly' tag the master forgot to remove."
	),

	-- Rare (1/40)
	item(7, "Crimson Edge", "Rare", "Quenched in plum wine. Rumored to bite cleaner when angry."),
	item(
		8,
		"Forest Whisper",
		"Rare",
		"Carved from a thousand-year cedar. The wind warns its enemies."
	),
	item(9, "Azure Tide", "Rare", "Wave-shaped damascus. Rings like a temple bell."),

	-- Epic (1/200)
	item(
		10,
		"Demon Slayer",
		"Epic",
		"Sutra-etched blade. Sealed shrine ghosts dislike its proximity."
	),
	item(11, "Spirit Reaper", "Epic", "Cuts the air a moment before its swing. Whispers names."),
	item(12, "Moonlight Bringer", "Epic", "Reflects no torchlight, only the moon."),

	-- Legendary (1/1,000)
	item(
		13,
		"Dragon's Roar",
		"Legendary",
		"Forged inside a stormcloud. Distant thunder follows you."
	),
	item(14, "Phoenix Flame", "Legendary", "Ash-tempered. Re-ignites when sheathed in starlight."),
	item(15, "Thunder Strike", "Legendary", "Each cut leaves a faint ozone perfume."),

	-- Mythic (1/10,000)
	item(16, "Yoru", "Mythic", "Pitch-black sentience. Refuses lesser duels."),
	item(17, "Tenseiga", "Mythic", "A sword that does not cut. It returns what was taken."),
	item(18, "Murasame", "Mythic", "Drinks rain. Demands a drop of blood per dawn."),

	-- Divine (1/100,000)
	item(
		19,
		"Excalibur",
		"Divine",
		"Rejected by every hand but yours. The lake whispers congratulations."
	),
	item(20, "Masamune", "Divine", "Refuses to harm the innocent. The blade will know."),
	item(21, "Muramasa", "Divine", "Eager. Restless. Pretend you don't hear it humming."),

	-- Celestial (1/1,000,000)
	item(22, "Susanoo", "Celestial", "A storm given a sheath. Sea-foam runs along the edge."),
	item(23, "Amaterasu", "Celestial", "Casts no shadow at noon. The handle is warm to the touch."),
	item(
		24,
		"Tsukuyomi",
		"Celestial",
		"Steals one hour of moonlight per swing. Returns it interest-free."
	),
} :: { Item }

Items.ById = {} :: { [number]: Item }
for _, it in Items.All do
	Items.ById[it.Id] = it
end

-- Items grouped by rarity key for quick lookup when a tier rolls.
Items.ByRarity = {} :: { [string]: { Item } }
for _, it in Items.All do
	local list = Items.ByRarity[it.RarityKey]
	if not list then
		list = {}
		Items.ByRarity[it.RarityKey] = list
	end
	table.insert(list, it)
end

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[--!strict
--
-- Defines the eight rarity tiers used by the RNG roll system.
--
-- `OneIn` is the nominal "1 / N" chance shown to players. Real probabilities
-- emerge from the cascading roll in RollService (rarest tier checked first).
-- `BannerColor` and `GlowColor` drive HUD presentation, while `ServerWideAnnounce`
-- toggles the server-wide announcement banner for top tiers.

export type Rarity = {
	Id: number,
	Key: string,
	Name: string,
	OneIn: number,
	Reward: number,
	BannerColor: Color3,
	GlowColor: Color3,
	ServerWideAnnounce: boolean,
}

local function tier(
	id: number,
	key: string,
	name: string,
	oneIn: number,
	reward: number,
	r: number,
	g: number,
	b: number,
	announce: boolean
): Rarity
	local color = Color3.fromRGB(r, g, b)
	return {
		Id = id,
		Key = key,
		Name = name,
		OneIn = oneIn,
		Reward = reward,
		BannerColor = color,
		GlowColor = color,
		ServerWideAnnounce = announce,
	}
end

local Rarities = {}

Rarities.Common = tier(1, "Common", "Common", 2, 1, 156, 163, 175, false)
Rarities.Uncommon = tier(2, "Uncommon", "Uncommon", 8, 2, 134, 239, 172, false)
Rarities.Rare = tier(3, "Rare", "Rare", 40, 5, 96, 165, 250, false)
Rarities.Epic = tier(4, "Epic", "Epic", 200, 15, 168, 85, 247, false)
Rarities.Legendary = tier(5, "Legendary", "Legendary", 1000, 50, 250, 204, 21, false)
Rarities.Mythic = tier(6, "Mythic", "Mythic", 10000, 200, 239, 68, 68, true)
Rarities.Divine = tier(7, "Divine", "Divine", 100000, 1000, 236, 72, 153, true)
Rarities.Celestial = tier(8, "Celestial", "Celestial", 1000000, 5000, 56, 189, 248, true)

-- Iteration order from rarest to most common. The roll routine walks this
-- list and short-circuits the first time it succeeds.
Rarities.OrderRarestFirst = {
	Rarities.Celestial,
	Rarities.Divine,
	Rarities.Mythic,
	Rarities.Legendary,
	Rarities.Epic,
	Rarities.Rare,
	Rarities.Uncommon,
	Rarities.Common,
}

-- Iteration order from common to rare for UI display.
Rarities.OrderCommonFirst = {
	Rarities.Common,
	Rarities.Uncommon,
	Rarities.Rare,
	Rarities.Epic,
	Rarities.Legendary,
	Rarities.Mythic,
	Rarities.Divine,
	Rarities.Celestial,
}

Rarities.ByKey = {} :: { [string]: Rarity }
Rarities.ById = {} :: { [number]: Rarity }
for _, t in Rarities.OrderRarestFirst do
	Rarities.ByKey[t.Key] = t
	Rarities.ById[t.Id] = t
end

return Rarities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">RemoteEvents</string>
          <string name="Source"><![CDATA[--!strict
--
-- Lazy-built `RemoteEvent` folder under ReplicatedStorage. Both server and
-- client `require` this module to obtain typed handles.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "RngKatanaRemotes"

local function ensureFolder(): Folder
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		return existing
	end
	if RunService:IsServer() then
		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
		return folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

local function ensureRemote(name: string): RemoteEvent
	local folder = ensureFolder()
	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	if RunService:IsServer() then
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

local RemoteEvents = {
	-- Server -> client: full profile snapshot
	StateChanged = ensureRemote("StateChanged"),
	-- Server -> client: a roll just resolved for *this* client
	RollResult = ensureRemote("RollResult"),
	-- Server -> all clients: someone rolled a Mythic+
	GlobalAnnounce = ensureRemote("GlobalAnnounce"),
	-- Client -> server: actions (Roll, BuyBoost, etc.)
	Action = ensureRemote("Action"),
	-- Server -> client: ad-hoc toast notification
	Notify = ensureRemote("Notify"),
}

return RemoteEvents
]]></string>
        </Properties>
      </Item>
